local lastEggCount = 0
local function getEggCount()
	local ls = player:FindFirstChild("leaderstats")
	if not ls then return 0 end
	for _, v in ipairs(ls:GetChildren()) do
		if v:IsA("IntValue") or v:IsA("NumberValue") then
			local n = v.Name:lower()
			if n:find("egg") or n:find("بيض") or n:find("steal") or n:find("collect") then
				return v.Value
			end
		end
	end
	return 0
end

lastEggCount = getEggCount()

local loopConn = RunService.Heartbeat:Connect(function()
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local myPos = hrp.Position

	local eggs = getEggs()
	counterLbl.Text = "🥚 البيض في المنطقة: " .. #eggs

	for _, l in pairs(espLabels) do pcall(function() l:Destroy() end) end
	espLabels = {}
	for _, d in pairs(radarDots) do pcall(function() d:Destroy() end) end
	radarDots = {}

	local nearest, nearestDist = nil, math.huge

	for _, egg in ipairs(eggs) do
		local pos = getPos(egg)
		if not pos then continue end
		local dist = (myPos - pos).Magnitude
		if dist < nearestDist then
			nearestDist = dist
			nearest = egg
		end

		if espEnabled then
			local adornee = egg:IsA("BasePart") and egg or (egg:IsA("Model") and egg.PrimaryPart)
			if adornee then
				local bb = Instance.new("BillboardGui")
				bb.Size = UDim2.fromOffset(90, 30)
				bb.StudsOffset = Vector3.new(0, 3.5, 0)
				bb.AlwaysOnTop = true
				bb.Adornee = adornee
				bb.Parent = espGui
				local txt = Instance.new("TextLabel", bb)
				txt.Size = UDim2.new(1, 0, 1, 0)
				txt.BackgroundColor3 = Color3.fromRGB(10, 14, 30)
				txt.BackgroundTransparency = 0.3
				txt.Font = Enum.Font.GothamBold
				txt.TextSize = 13
				txt.TextColor3 = Color3.fromRGB(255, 225, 50)
				txt.Text = "🥚 " .. math.floor(dist) .. "m"
				Instance.new("UICorner", txt).CornerRadius = UDim.new(0, 6)
				table.insert(espLabels, bb)
			end
		end

		if radarEnabled then
			local rel = pos - myPos
			local rx = math.clamp(rel.X / RADAR_RANGE, -1, 1)
			local rz = math.clamp(rel.Z / RADAR_RANGE, -1, 1)
			local dot = Instance.new("Frame")
			dot.Size = UDim2.fromOffset(7, 7)
			dot.Position = UDim2.new(0.5 + rx * 0.4, -3, 0.5 + rz * 0.4, -3)
			dot.BackgroundColor3 = Color3.fromRGB(255, 225, 50)
			dot.ZIndex = 2
			dot.Parent = radarFrame
			Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
			table.insert(radarDots, dot)
		end
	end

	if alertEnabled then
		if nearest and nearestDist <= ALERT_DIST then
			alertLbl.TextColor3 = Color3.fromRGB(110, 230, 160)
			alertLbl.Text = "🔔 بيضة قريبة جداً! " .. math.floor(nearestDist) .. "m"
		elseif nearest then
			alertLbl.TextColor3 = Color3.fromRGB(180, 185, 210)
			alertLbl.Text = "🥚 أقرب بيضة: " .. math.floor(nearestDist) .. "m"
		end
	end

	if autoEnabled then
		local cur = getEggCount()
		if cur > lastEggCount then
			lastEggCount = cur
			autoStatus.Text = "🤖 تم اكتشاف سرقة! جاري الرجوع..."
			task.spawn(function()
				smoothTp(ZONE1, nil)
				autoStatus.Text = "✅ رجعت لمنطقة 1"
				task.delay(2, function()
					if autoStatus and autoStatus.Parent then
						autoStatus.Text = ""
					end
				end)
			end)
		end
	end
end)

table.insert(connections, loopConn)

gui.Destroying:Connect(function()
	for _, c in pairs(connections) do pcall(function() c:Disconnect() end) end
	pcall(function() espGui:Destroy() end)
end)

