local loopConn = RunService.Heartbeat:Connect(function()
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local myPos = hrp.Position

	local eggs = getEggs()
	counterLbl.Text = "🥚 البيض في المنطقة: " .. #eggs

	for _, l in pairs(espLabels) do
		pcall(function() l:Destroy() end)
	end
	espLabels = {}

	for _, d in pairs(radarDots) do
		pcall(function() d:Destroy() end)
	end
	radarDots = {}

	local nearest = nil
	local nearestDist = math.huge

	for _, egg in ipairs(eggs) do
		local pos = getPos(egg)
		if not pos then continue end
		local dist = (myPos - pos).Magnitude

		if dist < nearestDist then
			nearestDist = dist
			nearest = egg
		end

		if espEnabled then
			local adornee = egg:IsA("BasePart") and egg or (egg:IsA("Model") and egg.PrimaryPart)
			if adornee then
				local bb = Instance.new("BillboardGui")
				bb.Size = UDim2.fromOffset(80, 28)
				bb.StudsOffset = Vector3.new(0, 3, 0)
				bb.AlwaysOnTop = true
				bb.Adornee = adornee
				bb.Parent = espGui
				local txt = Instance.new("TextLabel", bb)
				txt.Size = UDim2.new(1, 0, 1, 0)
				txt.BackgroundTransparency = 1
				txt.Font = Enum.Font.GothamBold
				txt.TextSize = 13
				txt.TextColor3 = Color3.fromRGB(255, 230, 50)
				txt.Text = "🥚 " .. math.floor(dist) .. "m"
				table.insert(espLabels, bb)
			end
		end

		if radarEnabled then
			local rel = pos - myPos
			local rx = math.clamp(rel.X / RADAR_RANGE, -1, 1)
			local rz = math.clamp(rel.Z / RADAR_RANGE, -1, 1)
			local dot = Instance.new("Frame")
			dot.Size = UDim2.fromOffset(6, 6)
			dot.Position = UDim2.new(0.5 + rx * 0.42, -3, 0.5 + rz * 0.42, -3)
			dot.BackgroundColor3 = Color3.fromRGB(255, 230, 50)
			dot.Parent = radarFrame
			Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
			table.insert(radarDots, dot)
		end
	end

	if alertEnabled then
		if nearest and nearestDist <= ALERT_DIST then
			alertStatus.TextColor3 = Color3.fromRGB(110, 230, 160)
			alertStatus.Text = "🔔 بيضة قريبة! " .. math.floor(nearestDist) .. "m"
		elseif nearest then
			alertStatus.TextColor3 = Color3.fromRGB(200, 200, 200)
			alertStatus.Text = "أقرب بيضة: " .. math.floor(nearestDist) .. "m"
		end
	end
end)

