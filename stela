openBtn.Size = UDim2.fromOffset(54, 54)
openBtn.Position = UDim2.fromOffset(8, camera.ViewportSize.Y / 2 - 27)
openBtn.Text = "🥚"
openBtn.Font = Enum.Font.GothamBold
openBtn.TextSize = 26
openBtn.AutoButtonColor = false
openBtn.BackgroundColor3 = ACCENT
openBtn.TextColor3 = Color3.new(1, 1, 1)
openBtn.ZIndex = 100
openBtn.Parent = gui
Instance.new("UICorner", openBtn).CornerRadius = UDim.new(1, 0)
local obs = Instance.new("UIStroke", openBtn)
obs.Color = Color3.new(1, 1, 1)
obs.Thickness = 2

local pressing, dragging, longHeld = false, false, false
local dragInput, startPos, btnStart
local pressId = 0

openBtn.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then
		pressing = true
		dragging = false
		longHeld = false
		dragInput = input
		startPos = input.Position
		btnStart = openBtn.AbsolutePosition
		pressId += 1
		local myId = pressId
		task.delay(4, function()
			if pressing and not dragging and pressId == myId then
				longHeld = true
				showKill()
			end
		end)
	end
end)

UIS.InputChanged:Connect(function(input)
	if not pressing then return end
	if input == dragInput or input.UserInputType == Enum.UserInputType.MouseMovement then
		local d = input.Position - startPos
		if not dragging and d.Magnitude > 10 then dragging = true end
		if dragging then
			local vp = camera.ViewportSize
			openBtn.Position = UDim2.fromOffset(
				math.clamp(btnStart.X + d.X, 0, vp.X - 54),
				math.clamp(btnStart.Y + d.Y, 0, vp.Y - 54)
			)
		end
	end
end)

UIS.InputEnded:Connect(function(input)
	if not pressing then return end
	local same = input == dragInput
		or (dragInput.UserInputType == Enum.UserInputType.MouseButton1
			and input.UserInputType == Enum.UserInputType.MouseButton1)
	if not same then return end
	pressing = false
	if dragging then
		dragging = false
	elseif not longHeld then
		main.Visible = not main.Visible
	end
end)