		end

		local stats = { speed = 16, jump = 50, gravity = workspace.Gravity }

		local function applyStats()
			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.WalkSpeed = stats.speed
				hum.UseJumpPower = true
				hum.JumpPower = stats.jump
			end
			workspace.Gravity = stats.gravity
		end

		do
			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hum then
				stats.speed = hum.WalkSpeed
				stats.jump = hum.UseJumpPower and hum.JumpPower or 50
			end
		end
		local ORIG = { speed = stats.speed, jump = stats.jump, gravity = stats.gravity }

		local charConn = player.CharacterAdded:Connect(function()
			task.wait(0.5)
			applyStats()
		end)

		gui.Destroying:Connect(function()
			charConn:Disconnect()
			stats.speed, stats.jump, stats.gravity = ORIG.speed, ORIG.jump, ORIG.gravity
			applyStats()
		end)

		local playerPage = Instance.new("ScrollingFrame")
		playerPage.Size = UDim2.new(1, 0, 1, -52)
		playerPage.Position = UDim2.new(0, 0, 0, 52)
		playerPage.BackgroundTransparency = 1
		playerPage.BorderSizePixel = 0
		playerPage.ScrollBarThickness = 3
		playerPage.CanvasSize = UDim2.new(0, 0, 0, 260)
		playerPage.Visible = false
		playerPage.Parent = area

		local playerInfo = makeText(playerPage, 16, Color3.fromRGB(160, 168, 205), false)
		playerInfo.Size = UDim2.new(1, 0, 0, 24)
		playerInfo.Text = player.DisplayName .. "  @" .. player.Name

		local valueLabels = {}

		local function makeStepper(y, title, key, step, min, max)
			local lbl = makeText(playerPage, 17, Color3.new(1, 1, 1), true)
			lbl.Size = UDim2.new(0, 84, 0, 36)
			lbl.Position = UDim2.new(0, 0, 0, y)
			lbl.Text = title

			local minus = makeBtn("-", 88, y, 36, 36, playerPage)
			local val = makeText(playerPage, 17, Color3.fromRGB(255, 210, 110), true)
			val.Size = UDim2.new(0, 56, 0, 36)
			val.Position = UDim2.new(0, 128, 0, y)
			val.TextXAlignment = Enum.TextXAlignment.Center
			local plus = makeBtn("+", 188, y, 36, 36, playerPage)

			local function refresh()
				val.Text = string.format("%.0f", stats[key])
			end
			valueLabels[key] = refresh
			refresh()

			minus.MouseButton1Click:Connect(function()
				stats[key] = math.max(min, stats[key] - step)
				refresh()
				applyStats()
			end)
			plus.MouseButton1Click:Connect(function()
				stats[key] = math.min(max, stats[key] + step)
				refresh()
				applyStats()
			end)
		end

		makeStepper(36, "السرعة", "speed", 8, 0, 200)
		makeStepper(84, "النطة", "jump", 25, 0, 300)
		makeStepper(132, "الجاذبية", "gravity", 20, 20, 300)

		local resetBtn = makeBtn("إعادة الضبط", 0, 184, 160, 36, playerPage)
		resetBtn.BackgroundColor3 = Color3.fromRGB(200, 40, 50)
		resetBtn.MouseButton1Click:Connect(function()
			stats.speed, stats.jump, stats.gravity = ORIG.speed, ORIG.jump, ORIG.gravity
			for _, refresh in pairs(valueLabels) do refresh() end
			applyStats()
		end)
