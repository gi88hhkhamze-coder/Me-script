local CAM_HEIGHT = 60
local CAM_RADIUS = 95
local center = Vector3.new(0, 0, 0)
do
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp then center = hrp.Position end
end

local angle = 0
cam.CameraType = Enum.CameraType.Scriptable
local camConn = RunService.RenderStepped:Connect(function(dt)
	angle += dt * 0.15
	local pos = center + Vector3.new(math.cos(angle) * CAM_RADIUS, CAM_HEIGHT, math.sin(angle) * CAM_RADIUS)
	cam.CFrame = CFrame.lookAt(pos, center + Vector3.new(0, 10, 0))
end)

local function closeIntro()
	pcall(function() camConn:Disconnect() end)
	cam.CameraType = Enum.CameraType.Custom
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then cam.CameraSubject = hum end
	pcall(function() blur:Destroy() end)
	pcall(function() introGui:Destroy() end)
end

