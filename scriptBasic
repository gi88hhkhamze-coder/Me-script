local function runRemote(url)
	if url == "" then
		statusLbl.Text = "ضع رابط السكربت في قائمة GAMES"
		return
	end
	statusLbl.Text = "جاري التحميل..."
	task.spawn(function()
		local ok, res = pcall(function()
			return game:HttpGet(url)
		end)
		if not ok or not res or res == "" then
			statusLbl.Text = "فشل تحميل الرابط"
			return
		end
		local fn = loadstring(res)
		if not fn then
			statusLbl.Text = "السكربت فيه خطأ"
			return
		end
		local ok2, e2 = pcall(fn)
		if ok2 then
			closeIntro()
		else
			statusLbl.Text = "خطأ: " .. tostring(e2)
		end
	end)
end

