local function runRemoteScript(url, btnRef)
	if url == "" then
		statusLbl.Text = "ضع رابط السكربت في GAMES"
		return
	end
	statusLbl.Text = "⏳ جاري التحميل..."
	if btnRef then btnRef.BackgroundColor3 = Color3.fromRGB(80, 80, 80) end
	task.spawn(function()
		local ok, res = pcall(function() return game:HttpGet(url) end)
		if not ok or not res or res == "" then
			statusLbl.Text = "❌ فشل تحميل الرابط"
			if btnRef then btnRef.BackgroundColor3 = Color3.fromRGB(40, 90, 230) end
			return
		end
		local fn, loadErr = loadstring(res)
		if not fn then
			statusLbl.Text = "❌ خطأ: " .. tostring(loadErr)
			if btnRef then btnRef.BackgroundColor3 = Color3.fromRGB(40, 90, 230) end
			return
		end
		local ok2, e2 = pcall(fn)
		if ok2 then
			closeIntro()
		else
			statusLbl.Text = "❌ خطأ: " .. tostring(e2)
			if btnRef then btnRef.BackgroundColor3 = Color3.fromRGB(40, 90, 230) end
		end
	end)
end

